# =========================================================================
# PostulaTrack Frontend - Gitignore
# =========================================================================

# 1. Dependencias
/node_modules
/npm-debug.log*
/yarn-error.log
/yarn.lock
pnpm-debug.log*
.pnpm-store

# 2. Archivos de Construcción y Caché de Angular
/dist
/tmp
/out-tsc
/bazel-out
/.angular
/.angular/cache
/.nx

# 3. Pruebas y Cobertura
/coverage
testem.log
/typings
__screenshots__/
__image_snapshots__/
*.lcov

# 4. Entorno y Secretos
# NOTA: Asegúrate de no subir claves privadas ni secrets a tu repo.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials.json

# 5. Herramientas del Sistema y SO
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# 6. IDEs y Editores de Código
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.sublime-project
.history/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# 7. Archivos Adicionales (Logs y misceláneos)
*.log
/connect.lock
/libpeerconnection.log
dump.rdb

# 8. Archivos generados temporalmente (e.g. Docker o scripts)
docker-compose.override.yml
